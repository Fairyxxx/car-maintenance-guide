/* components/onboarding-guide —— 首次启动引导样式（科技霓虹风，与 app.wxss 一致） */
.onb-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 0 calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #080b14 0%, #0a0e17 55%, #0c1322 100%);
  overflow: hidden;
}

/* 背景光晕：呼应首页 hero 的霓虹辉光 */
.onb-bg-glow {
  position: absolute;
  top: -160rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 720rpx;
  height: 720rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 240, 255, 0.18), rgba(139, 92, 246, 0.1) 45%, transparent 70%);
  pointer-events: none;
}

.onb-skip {
  position: relative;
  align-self: flex-end;
  margin: 36rpx 36rpx 0;
  font-size: 24rpx;
  color: var(--text-3);
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  z-index: 2;
}

.onb-swiper {
  width: 100%;
  flex: 1;
  z-index: 1;
}

.onb-slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  text-align: center;
}

.onb-icon {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  margin-bottom: 48rpx;
  background: rgba(15, 23, 42, 0.7);
  border: 2rpx solid rgba(0, 240, 255, 0.28);
  box-shadow: 0 0 48rpx rgba(0, 240, 255, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}
.onb-icon-neutral {
  border-color: rgba(0, 240, 255, 0.35);
  box-shadow: 0 0 48rpx rgba(0, 240, 255, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}
.onb-icon-how {
  border-color: rgba(139, 92, 246, 0.4);
  box-shadow: 0 0 48rpx rgba(139, 92, 246, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}
.onb-icon-privacy {
  border-color: rgba(52, 211, 153, 0.4);
  box-shadow: 0 0 48rpx rgba(52, 211, 153, 0.26), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.onb-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 0.02em;
  background: linear-gradient(135deg, #00f0ff 0%, #8b5cf6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 20rpx;
}

.onb-desc {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-2);
  max-width: 560rpx;
}

.onb-steps {
  margin-top: 44rpx;
  width: 100%;
  max-width: 560rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.onb-step {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 26rpx;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  text-align: left;
}
.onb-step-num {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #020617;
  background: linear-gradient(135deg, #00f0ff, #38bdf8);
}
.onb-step-text {
  font-size: 27rpx;
  color: var(--text);
  font-weight: 600;
}

.onb-dots {
  display: flex;
  gap: 14rpx;
  margin: 24rpx 0 36rpx;
  z-index: 2;
}
.onb-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.3);
  transition: all 0.25s ease;
}
.onb-dot.on {
  width: 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #00f0ff, #8b5cf6);
  box-shadow: 0 0 14rpx rgba(0, 240, 255, 0.4);
}

.onb-actions {
  width: 100%;
  padding: 0 44rpx;
  z-index: 2;
}
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}
.btn::after { border: none; }
.onb-btn-ghost {
  background: transparent;
  color: var(--c-primary);
  border: 2rpx solid rgba(0, 240, 255, 0.35);
}
.onb-btn-primary {
  background: linear-gradient(135deg, #00f0ff 0%, #0ea5e9 100%);
  color: #020617;
  box-shadow: 0 6rpx 28rpx rgba(0, 240, 255, 0.28);
}
.onb-btn-primary:active { opacity: 0.9; }
