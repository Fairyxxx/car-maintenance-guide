<view class="page">
  <view class="hero card">
    <view class="hero-name">隐私政策</view>
    <view class="hero-sub muted">最后更新：{{updatedAt}}</view>
  </view>

  <view class="sec card" wx:for="{{sections}}" wx:key="title" wx:for-item="sec">
    <view class="sec-title">{{sec.title}}</view>
    <view class="sec-item" wx:for="{{sec.items}}" wx:for-item="line" wx:key="*this">
      <text class="dot">·</text>
      <text class="txt">{{line}}</text>
    </view>
  </view>

  <view class="tiny muted center" style="margin: 32rpx 12rpx 48rpx; line-height:1.7;">
    如对本政策有疑问，可通过微信小程序内置的「反馈与投诉」入口向我们反馈。我们不会将你的信息用于任何商业用途。
  </view>
</view>
