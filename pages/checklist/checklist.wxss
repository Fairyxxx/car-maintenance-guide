.hero {
  text-align: center;
  padding: 28rpx 24rpx;
  margin-bottom: 6rpx;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: "";
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 50% 0%, rgba(0, 240, 255, 0.12), transparent 50%);
  pointer-events: none;
}
.hero-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: left;
}
.hero-info {
  flex: 1;
  min-width: 0;
}
.hero-name {
  font-size: 26rpx;
  color: var(--text-2);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.hero-km-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
}
.hero-km {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--c-primary);
  font-family: "DIN Alternate", "SF Pro Display", "PingFang SC", sans-serif;
  text-shadow: 0 0 28rpx rgba(0, 240, 255, 0.35);
  line-height: 1.1;
}
.hero-edit {
  display: inline-block;
  font-size: 22rpx;
  color: var(--c-primary);
  border: 1rpx solid rgba(0, 240, 255, 0.3);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}
.hero-edit:active {
  background: rgba(0, 240, 255, 0.12);
}

/* 健康度大环：conic-gradient 实时绘制进度，降级为纯色圆仍可读；
   中心镂空由 .gauge-inner 遮住，露出分数。 */
.gauge {
  flex: none;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 30rpx rgba(0, 0, 0, 0.3);
}
.gauge.bad { box-shadow: 0 0 30rpx rgba(255, 77, 109, 0.3); }
.gauge.warn { box-shadow: 0 0 30rpx rgba(251, 191, 36, 0.26); }
.gauge.good { box-shadow: 0 0 30rpx rgba(52, 211, 153, 0.26); }
.gauge-inner {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--bg-elevated);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.gauge-score {
  font-size: 60rpx;
  font-weight: 800;
  font-family: "DIN Alternate", "SF Pro Display", "PingFang SC", sans-serif;
  color: var(--text);
}
.gauge-unit {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}
.gauge-label {
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 6rpx;
  letter-spacing: 0.04em;
}
.gauge.bad .gauge-label { color: var(--c-overdue); }
.gauge.warn .gauge-label { color: var(--c-soon); }
.gauge.good .gauge-label { color: var(--c-ok); }
.hero-unit {
  font-size: 30rpx;
  color: var(--text-2);
  font-weight: 600;
  margin-left: 8rpx;
}
.counts {
  display: flex;
  gap: 12rpx;
}
.count {
  flex: 1;
  background: rgba(2, 6, 23, 0.45);
  border-radius: 12rpx;
  padding: 16rpx 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
}
.num {
  font-size: 40rpx;
  font-weight: 800;
  font-family: "DIN Alternate", "SF Pro Display", "PingFang SC", sans-serif;
}
.lbl {
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 4rpx;
  letter-spacing: 0.04em;
}
.count.overdue .num { color: var(--c-overdue); text-shadow: 0 0 16rpx rgba(255, 77, 109, 0.35); }
.count.soon .num { color: var(--c-soon); text-shadow: 0 0 16rpx rgba(251, 191, 36, 0.3); }
.count.ok .num { color: var(--c-ok); text-shadow: 0 0 16rpx rgba(52, 211, 153, 0.3); }
.count.skip .num { color: var(--c-skip); }
.eval-time {
  margin-top: 16rpx;
}

.loading {
  padding: 140rpx 0;
}

.section-title.danger { color: var(--c-overdue); text-shadow: 0 0 12rpx rgba(255, 77, 109, 0.25); }
.section-title.warn { color: var(--c-soon); text-shadow: 0 0 12rpx rgba(251, 191, 36, 0.2); }
.section-title.skip-title { color: var(--c-skip); }
.section-title.collapse {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.caret {
  color: var(--c-primary);
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
}

.skip-banner {
  text-align: center;
  margin-bottom: 16rpx;
  border-color: rgba(139, 92, 246, 0.35);
  box-shadow: 0 0 24rpx rgba(139, 92, 246, 0.1), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}
.skip-banner-title {
  font-weight: 700;
  font-size: 26rpx;
  color: #c4b5fd;
}
.skip-banner-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.disclaimer {
  margin: 32rpx 8rpx 24rpx;
  line-height: 1.6;
  color: var(--text-3);
}

.manual {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
  border-color: rgba(0, 240, 255, 0.28);
  box-shadow: 0 0 22rpx rgba(0, 240, 255, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}
.manual-badge {
  flex: none;
  font-size: 22rpx;
  font-weight: 700;
  color: #021014;
  background: linear-gradient(135deg, #00f0ff, #38bdf8);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  letter-spacing: 0.04em;
}
.manual-body {
  flex: 1;
  min-width: 0;
}
.manual-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #e2f6ff;
}
.manual-scope {
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.5;
}
.manual-note {
  font-size: 22rpx;
  margin-top: 8rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.lastsvc {
  margin-bottom: 16rpx;
  border-color: rgba(52, 211, 153, 0.3);
  box-shadow: 0 0 22rpx rgba(52, 211, 153, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}
.lastsvc.empty {
  border-color: rgba(255, 255, 255, 0.06);
  box-shadow: none;
}
.lastsvc-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.lastsvc-badge {
  flex: none;
  font-size: 22rpx;
  font-weight: 700;
  color: #02140d;
  background: linear-gradient(135deg, #34d399, #10b981);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  letter-spacing: 0.04em;
}
.lastsvc-meta {
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 600;
}
.lastsvc-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  font-size: 24rpx;
  color: #bbf7d0;
  background: rgba(16, 185, 129, 0.12);
  border: 1rpx solid rgba(52, 211, 153, 0.3);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.lastsvc-empty {
  font-size: 22rpx;
  line-height: 1.5;
}

/* 全部保养记录流水账 */
.his {
  margin-bottom: 16rpx;
  border-color: rgba(0, 240, 255, 0.22);
  box-shadow: 0 0 22rpx rgba(0, 240, 255, 0.07), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}
.his-hd {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.his-badge {
  flex: none;
  font-size: 22rpx;
  font-weight: 700;
  color: #021014;
  background: linear-gradient(135deg, #00f0ff, #38bdf8);
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  letter-spacing: 0.04em;
}
.his-count {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-2);
  font-weight: 600;
}
.his-list {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line);
  padding-top: 4rpx;
}
.his-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}
.his-item:last-child {
  border-bottom: none;
}
.his-meta {
  display: flex;
  flex-direction: column;
  flex: none;
}
.his-date {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 700;
  font-family: "DIN Alternate", "SF Pro Display", "PingFang SC", sans-serif;
}
.his-km {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 2rpx;
}
.his-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  min-width: 0;
}
.his-name {
  font-size: 26rpx;
  color: var(--c-primary);
  text-align: right;
}
.his-del {
  font-size: 22rpx;
  color: var(--c-overdue);
  background: rgba(255, 77, 109, 0.1);
  border: 1rpx solid rgba(255, 77, 109, 0.3);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}
.his-del:active {
  background: rgba(255, 77, 109, 0.2);
}

/* 体检页底部需给固定操作栏让出空间，否则免责声明会被遮挡 */
.page {
  padding-bottom: 180rpx;
}

/* 补录弹层（底部抽屉式） */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(2, 6, 23, 0.72);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
  backdrop-filter: blur(4rpx);
}
.modal {
  width: 100%;
  background: var(--bg-elevated);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  border: 1rpx solid var(--line);
  border-bottom: none;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  overflow-y: auto;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.4);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text);
}
.modal-sub {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 8rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

/* 表单字段（与 vehicle-add / profile 同款样式，本页独立声明） */
.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
}
.label {
  width: 200rpx;
  font-size: 26rpx;
  color: var(--text-2);
  flex: none;
}
.opt {
  color: var(--text-3);
  font-size: 22rpx;
}
.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text);
}
.unit {
  width: 56rpx;
  text-align: right;
  color: var(--text-2);
  font-size: 24rpx;
  flex: none;
}
.divider {
  height: 2rpx;
  background: var(--line);
}
.picker {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--text);
}
.picker.placeholder {
  color: var(--text-3);
}

/* 选择更换了哪些项目 */
.rec-title {
  font-size: 26rpx;
  font-weight: 700;
  margin: 16rpx 0 12rpx;
}
.rec-items {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.rec-item {
  font-size: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid var(--card-border);
  color: var(--text-2);
}
.rec-item.on {
  background: rgba(0, 240, 255, 0.12);
  border-color: var(--c-primary);
  color: var(--c-primary);
  box-shadow: 0 0 14rpx rgba(0, 240, 255, 0.18);
}
.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

/* 上次保养空状态行：badge 与「补录」两端对齐（原未样式，补最小补齐） */
.lastsvc-empty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lastsvc-edit {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--c-primary);
}

/* 下次保养预告（hero 内胶囊）：状态色随 nextDue.status 切换 */
.nextdue {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  width: fit-content;
  max-width: 100%;
  margin: 18rpx auto 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(2, 6, 23, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}
.nextdue.overdue { border-color: rgba(255, 77, 109, 0.45); box-shadow: 0 0 18rpx rgba(255, 77, 109, 0.15); }
.nextdue.soon { border-color: rgba(251, 191, 36, 0.4); box-shadow: 0 0 18rpx rgba(251, 191, 36, 0.12); }
.nextdue.ok { border-color: rgba(52, 211, 153, 0.4); box-shadow: 0 0 18rpx rgba(52, 211, 153, 0.12); }
.nextdue-lbl {
  font-size: 22rpx;
  color: var(--text-2);
  letter-spacing: 0.04em;
  flex: none;
}
.nextdue-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text);
}
.nextdue.overdue .nextdue-text { color: var(--c-overdue); }
.nextdue.soon .nextdue-text { color: var(--c-soon); }
.nextdue.ok .nextdue-text { color: var(--c-ok); }

/* 提醒弹层内：下次该保养的项，居中高亮块 */
.remind-due {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(2, 6, 23, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  text-align: center;
}
.remind-due.overdue { border-color: rgba(255, 77, 109, 0.4); }
.remind-due.soon { border-color: rgba(251, 191, 36, 0.38); }
.remind-due.ok { border-color: rgba(52, 211, 153, 0.38); }
.remind-due-lbl {
  font-size: 22rpx;
  color: var(--text-2);
  margin-bottom: 8rpx;
}
.remind-due-text {
  font-size: 32rpx;
  font-weight: 800;
}
.remind-due.overdue .remind-due-text { color: var(--c-overdue); }
.remind-due.soon .remind-due-text { color: var(--c-soon); }
.remind-due.ok .remind-due-text { color: var(--c-ok); }

/* 提醒弹层内：如何不错过保养（收藏引导）— 用 ok 绿做提示框 */
.remind-tip {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(52, 211, 153, 0.06);
  border: 1rpx solid rgba(52, 211, 153, 0.22);
}
.remind-tip-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #bbf7d0;
  margin-bottom: 12rpx;
}
.remind-tip-row {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.remind-tip-row:last-child { margin-bottom: 0; }
