.vrow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid var(--card-border);
  border-radius: 14rpx;
  padding: 22rpx;
}

/* 跨车仪表盘：三张等宽卡片，顶部渐变描边呼应首页 hero */
.dash {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.dash-card {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 16rpx;
  padding: 22rpx 12rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 20rpx rgba(0, 240, 255, 0.05), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}
.dash-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #00f0ff, #8b5cf6);
}
.dash-num {
  font-size: 38rpx;
  font-weight: 800;
  font-family: "DIN Alternate", "SF Pro Display", "PingFang SC", sans-serif;
  color: var(--text);
  line-height: 1.1;
}
.dash-lbl {
  font-size: 21rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}
.dash-card.alert .dash-num {
  color: var(--c-overdue);
  text-shadow: 0 0 16rpx rgba(255, 77, 109, 0.35);
}
.dash-card.alert::before {
  background: linear-gradient(90deg, #ff4d6d, #f59e0b);
}
.vrow.active {
  border-color: var(--c-primary);
  background: rgba(0, 240, 255, 0.08);
  box-shadow: 0 0 18rpx rgba(0, 240, 255, 0.12);
}
.vrow-main {
  flex: 1;
  min-width: 0;
}
.vrow-name {
  font-size: 28rpx;
  font-weight: 700;
}
.vrow-km {
  font-size: 24rpx;
  color: var(--text-2);
}
.vrow-actions {
  flex: none;
  display: flex;
  gap: 12rpx;
  margin-left: 16rpx;
}
.vrow-edit {
  font-size: 24rpx;
  color: var(--c-primary);
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(0, 240, 255, 0.35);
  border-radius: 999rpx;
}
.vrow-del {
  font-size: 24rpx;
  color: var(--c-overdue);
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 77, 109, 0.4);
  border-radius: 999rpx;
}

.empty {
  padding: 56rpx 0;
}

.add-btn {
  margin-top: 4rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.form {
  padding: 8rpx 24rpx;
}
.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
}
.label {
  width: 200rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text);
}
.unit {
  width: 56rpx;
  text-align: right;
  color: var(--text-2);
}
.save {
  margin: 20rpx 0 12rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 26rpx 24rpx;
  background: rgba(15, 23, 42, 0.6);
  border: 1rpx solid var(--card-border);
  border-radius: 14rpx;
}
.entry-label {
  font-size: 28rpx;
  font-weight: 600;
}
.entry-arrow {
  font-size: 36rpx;
  color: var(--text-2);
  line-height: 1;
}
